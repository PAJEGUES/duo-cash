# Copie para .env (o setup-vm.sh faz isso e gera as senhas).

# Domínio público com HTTPS. Sem domínio próprio, use o IP com sslip.io: 34-12-1-9.sslip.io
DOMAIN=
# Mesmo domínio com https://, usado no link de convite
PUBLIC_BASE_URL=

# Gerados automaticamente pelo setup-vm.sh (openssl rand -hex). Use só [0-9a-f].
POSTGRES_PASSWORD=
SECRET_KEY=

# Client IDs OAuth do Google aceitos, separados por vírgula. O PRIMEIRO deve ser o client "Web".
GOOGLE_CLIENT_IDS=

# Validade dos convites, em minutos
INVITE_TTL_MINUTES=60
